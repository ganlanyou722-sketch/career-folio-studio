# Model endpoint: full OpenAI-compatible chat completions URL.
CV_MODEL_ENDPOINT=
CV_MODEL_NAME=
CV_MODEL_KEY=
# Set to 1 only when the chosen model accepts images.
CV_MODEL_VISION=0
# Leave blank for local use. For external access choose a long random code.
CV_INVITE_CODE=
# Default server listens at localhost on port 4399.
HOST=127.0.0.1
PORT=4399
# For external deployment set the public HTTPS origin (without a trailing slash).
PUBLIC_ORIGIN=
