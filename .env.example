# DeepSeek official API. Paste the key into .env locally or a hosting Secret.
DEEPSEEK_API_KEY=
# Optional override for the text model. Defaults to deepseek-flash.
CV_MODEL_NAME=
# Optional alternate Chat Completions provider. Use its own CV_MODEL_KEY.
CV_MODEL_ENDPOINT=
CV_MODEL_KEY=
# DeepSeek uses Flash for images by default. Set 0 to disable it.
# For an alternate provider, set 1 only when its model accepts images.
CV_MODEL_VISION=
# Leave blank for local use. For external access choose a long random code.
CV_INVITE_CODE=
# Default server listens at localhost on port 4399.
HOST=127.0.0.1
PORT=4399
# CloudBase Run public HTTPS origin. Required to enable uploads and AI externally.
PUBLIC_ORIGIN=
